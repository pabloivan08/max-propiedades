---
import SearchLayout from '../components/SearchLayout.jsx';
import '../styles/global.css';

const locale = Astro.currentLocale ?? 'es';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Propiedades | Inmobiliaria MVP</title>
    <meta
      name="description"
      content="Encuentra tu próxima propiedad con búsqueda interactiva en mapa."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  </head>
  <body>
    <SearchLayout client:only="react" locale={locale} />
  </body>
</html>
